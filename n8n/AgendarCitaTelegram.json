    {
      "parameters": {
        "jsCode": "// Parsea el mensaje: formato ->  CITA <ci> <especialidad> <YYYY-MM-DD> <HH:MM>\n// Ej:  CITA 1000000 cardiologia 2026-08-15 10:00\nconst text = ($('Telegram Trigger').item.json.message.text || '').trim();\n\nconst ci    = (text.match(/\\d{6,8}/) || [''])[0];\nconst fecha = (text.match(/\\d{4}-\\d{2}-\\d{2}/) || [''])[0];\nconst horaM = text.match(/\\b([01]?\\d|2[0-3]):[0-5]\\d\\b/);\nconst hora  = horaM ? horaM[0] : '10:00';\n\n// especialidad = lo que queda tras quitar \"CITA\", el CI, la fecha y la hora\nlet especialidad = text\n  .replace(/^\\/?\\s*cita/i, '')\n  .replace(ci, '')\n  .replace(fecha, '')\n  .replace(hora, '')\n  .replace(/\\s+/g, ' ')\n  .trim();\nif (!especialidad) especialidad = 'general';\n\n// Bolivia es UTC-4. Se arma la fecha ISO con ese offset.\nconst fechaHora = fecha ? `${fecha}T${hora}:00-04:00` : '';\n\nreturn [{ json: { ci, especialidad, fecha, hora, fechaHora } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        -128
      ],
      "id": "c64c2097-70f7-4d53-88f1-7d3c98d632d0",
      "name": "Parse mensaje"
    },
    {
