        "jsCode": "// Parsea el mensaje WhatsApp: CITA <ci> <especialidad> <YYYY-MM-DD> <HH:MM>\n// Ej: CITA 1000000 Cardiologia 2026-08-15 10:18\nconst text = ($('WhatsApp Trigger').item.json.messages[0].text.body || '').trim();\n\nconst ci    = (text.match(/\\d{6,8}/) || [''])[0];\nconst fecha = (text.match(/\\d{4}-\\d{2}-\\d{2}/) || [''])[0];\nconst horaM = text.match(/\\b([01]?\\d|2[0-3]):[0-5]\\d\\b/);\nconst hora  = horaM ? horaM[0] : '10:00';\n\nlet especialidad = text\n  .replace(/^\\/?\\s*cita/i, '')\n  .replace(ci, '')\n  .replace(fecha, '')\n  .replace(hora, '')\n  .replace(/\\s+/g, ' ')\n  .trim();\nif (!especialidad) especialidad = 'general';\n\n// Bolivia UTC-4\nconst fechaHora = fecha ? `${fecha}T${hora}:00-04:00` : '';\n\nreturn [{ json: { ci, especialidad, fecha, hora, fechaHora } }];\n"
