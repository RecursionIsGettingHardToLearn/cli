      "id": "wh-evo-001",
      "name": "Webhook Evolution",
      "webhookId": "whatsapp-clinica-evo"
    },
    {
      "parameters": {
        "jsCode": "// Evolution API webhook. El numero REAL del emisor esta en body.sender,\n// NO en key.remoteJid (que a veces trae el numero de la instancia).\n// El campo key.fromMe es poco confiable en Baileys, por eso detectamos\n// mensajes propios comparando el sender con el numero de la clinica.\nconst body = $json.body ?? $json;\nconst data = body.data ?? {};\n\n// Numero de la clinica (la instancia que escaneo el QR)\nconst NUMERO_CLINICA = '59165017251';\n\n// Emisor real del mensaje\nconst senderRaw = (body.sender || data.key?.remoteJid || '').replace('@s.whatsapp.net', '').replace('@lid', '');\nconst numero = senderRaw;\n\n// Es propio si el emisor es la misma clinica\nconst fromMe = numero === NUMERO_CLINICA;\n\nconst text = (data.message?.conversation\n  || data.message?.extendedTextMessage?.text\n  || '').trim();\n\nconst ci    = (text.match(/\\d{6,8}/) || [''])[0];\nconst fecha = (text.match(/\\d{4}-\\d{2}-\\d{2}/) || [''])[0];\nconst horaM = text.match(/\\b([01]?\\d|2[0-3]):[0-5]\\d\\b/);\nconst hora  = horaM ? horaM[0] : '10:00';\n\nlet especialidad = text\n  .replace(/^\\/?\\s*cita/i, '')\n  .replace(ci, '')\n  .replace(fecha, '')\n  .replace(hora, '')\n  .replace(/\\s+/g, ' ')\n  .trim();\nif (!especialidad) especialidad = 'general';\n\nconst fechaHora = fecha ? `${fecha}T${hora}:00-04:00` : '';\nconst esCita = /^\\/?\\s*cita/i.test(text);\n\nreturn [{ json: { numero, text, ci, especialidad, fecha, hora, fechaHora, fromMe, esCita } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        0
      ],
      "id": "parse-evo-001",
      "name": "Parse mensaje"
    },
