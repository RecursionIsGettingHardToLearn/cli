APP_NAME=ms-diagnostico-ia
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:8080

# === Proveedor de IA: OpenAI (unico) ===
# Si no hay clave, el servicio se degrada a reglas locales (demo, confianza 0.35).
IA_PROVIDER_ORDER=openai

# OpenAI: reportes por voz (Whisper + chat), pre-triaje y analisis de imagen (vision).
# Pega tu clave real solo en .env (este .example si se puede subir).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Modelo multimodal para /api/analizar-imagen (gpt-4o-mini soporta vision).
OPENAI_VISION_MODEL=gpt-4o-mini

DATABASE_URL=sqlite:///./data/ms_ia.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# sqlite mantiene el modo local. Usa dynamodb en Render/AWS.
STORAGE_BACKEND=sqlite
AWS_REGION=sa-east-1
DYNAMODB_TABLE=ms2_diagnostico_ia
S3_BUCKET=
S3_PREFIX=uploads
