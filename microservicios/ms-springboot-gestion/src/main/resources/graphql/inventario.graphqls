# Categoria y Proveedor se definen en categoria.graphqls / proveedor.graphqls
# (sus resolvers viven en CategoriaController / ProveedorController). Aqui solo
# se referencian desde Medicamento.categoria y Lote.proveedor.

type Medicamento {
  id: UUID!
  nombre: String!
  descripcion: String
  categoria: Categoria
  precioVenta: BigDecimal!
  requiereReceta: Boolean!
  controlado: Boolean!
  stockMinimo: Int!
  activo: Boolean!
  createdAt: DateTime
  updatedAt: DateTime
}

input MedicamentoInput {
  nombre: String!
  descripcion: String
  categoriaId: Int
  precioVenta: BigDecimal!
  requiereReceta: Boolean
  controlado: Boolean
  stockMinimo: Int
}

type Lote {
  id: UUID!
  medicamento: Medicamento!
  proveedor: Proveedor
  codigoLote: String!
  fechaVencimiento: Date!
  cantidadInicial: Int!
  cantidadActual: Int!
  precioCompra: BigDecimal!
  createdAt: DateTime
}

input LoteInput {
  medicamentoId: UUID!
  proveedorId: UUID
  codigoLote: String!
  fechaVencimiento: Date!
  cantidad: Int!
  precioCompra: BigDecimal!
}

enum TipoMovimiento { ENTRADA SALIDA AJUSTE }

type MovimientoInventario {
  id: UUID!
  lote: Lote!
  tipo: TipoMovimiento!
  cantidad: Int!
  motivo: String
  fecha: DateTime!
}

extend type Query {
  medicamentos(q: String, activo: Boolean): [Medicamento!]!
  medicamento(id: UUID!): Medicamento
  lotesByMedicamento(medicamentoId: UUID!): [Lote!]!
  movimientosByLote(loteId: UUID!): [MovimientoInventario!]!
}

extend type Mutation {
  crearMedicamento(input: MedicamentoInput!): Medicamento!
  actualizarMedicamento(id: UUID!, input: MedicamentoInput!): Medicamento!
  desactivarMedicamento(id: UUID!): Medicamento!

  registrarEntradaLote(input: LoteInput!): Lote!
  ajustarStock(loteId: UUID!, cantidad: Int!, motivo: String!): MovimientoInventario!
}
